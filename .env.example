# Local review only. Development accounts are always disabled in production.
DEMO_MODE=true

# Canonical origin used for protected links in calendar events and email drafts.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Uploaded audio and images ---
# A folder on the hosting disk OUTSIDE the deployed app, so deploys never delete uploads.
# Example on Hostinger: /home/<your-user>/mcc-uploads  (empty = ./.uploads for local work)
UPLOADS_DIR=

# --- Resend (email) ---
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "Morning Coffee <hello@yourdomain.com>"
EMAIL_FROM=
# Daily send limit shown in the admin (free tier is 100)
EMAIL_DAILY_LIMIT=100

# --- Stripe (later) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Zoom Server-to-Server OAuth (later) ---
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
